@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <h2 class="flex items-center gap-2">
                <span class="sidebar-logo" aria-hidden="true">L</span>
                <span>LFS</span>
            </h2>
            <p class="sidebar-brand-sub">Proyecto Asana</p>
        </div>
        <ProjectSelector @rendermode="InteractiveServer" />
        <nav class="sidebar-nav" aria-label="Main">
            <NavLink class="sidebar-nav-link" ActiveClass="is-active" href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink class="sidebar-nav-link" ActiveClass="is-active" href="/pipeline">Pipeline</NavLink>
            <NavLink class="sidebar-nav-link" ActiveClass="is-active" href="/mover-oportunidades">Mover oportunidades</NavLink>
            <NavLink class="sidebar-nav-link" ActiveClass="is-active" href="/historial-movimientos">Historial movimientos</NavLink>
            <NavLink class="sidebar-nav-link" ActiveClass="is-active" href="/oportunidades">Oportunidades</NavLink>
            <hr class="sidebar-divider" />
            <SidebarMailNav />
        </nav>
    </aside>
    <main class="content">
        @Body
    </main>
</div>
